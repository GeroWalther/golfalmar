# ─────────────────────────────────────────────────────────────────────────
# GOLF AL MAR — environment variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development, or paste these
# values into your hosting platform's env config (Vercel → Project →
# Settings → Environment Variables, Railway → Variables, etc.).
#
# Anything ending in `.local` is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────


# ── Site URL ─────────────────────────────────────────────────────────────
# The full public origin. Used for canonical URLs, sitemap, Open Graph
# metadata (WhatsApp/Messenger previews), Stripe success/cancel redirects,
# and absolute image paths in marketing emails.
#
# Local dev:  http://localhost:1515
# Production: https://golfalmar.com   (or whatever your domain is)
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# ── MongoDB Atlas ────────────────────────────────────────────────────────
# Persists Orders and BlogPosts.
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?...
# Tip: in Atlas → Network Access, add your hosting provider's egress IPs
# (or 0.0.0.0/0 with strong DB user creds for serverless platforms).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/golfalmar?retryWrites=true&w=majority


# ── Stripe ───────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys.
# Use TEST keys (`sk_test_…`) until you're ready to charge real cards,
# then swap to LIVE keys (`sk_live_…`) once your account is activated.
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Stripe webhook signing secret. One per webhook endpoint.
#
# Production: in Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL:    https://your-domain.com/api/webhooks/stripe
#   Events: checkout.session.completed
# Then copy the "Signing secret" (whsec_…) here.
#
# Local dev: run `stripe listen --forward-to http://localhost:1515/api/webhooks/stripe`
# and copy the whsec_… it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxx


# ── Resend (transactional email) ─────────────────────────────────────────
# Sends order confirmation + shipped notification emails.
# Get your API key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxx

# Verified sender. The domain must be verified in your Resend dashboard
# (Domains → Add Domain → add the DNS records they show you).
# Until verified, emails will fall back to onboarding@resend.dev — fine
# for testing, but bad for deliverability in production.
RESEND_FROM=GOLF AL MAR <orders@your-domain.com>

# Inbox that receives the "new order" notification when a checkout completes.
# Goes to the shop owner — separate from the customer email.
OWNER_EMAIL=you@your-domain.com


# ── Admin dashboard access ───────────────────────────────────────────────
# Protects /admin and /api/admin/* with HTTP Basic Auth (configured in
# src/proxy.ts). Browser pops a credential dialog on first visit.
#
# Live URL: https://your-domain.com/admin
# Use a strong, randomly-generated password. Treat these like prod creds.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password


# ─────────────────────────────────────────────────────────────────────────
# Deployment notes
# ─────────────────────────────────────────────────────────────────────────
# Vercel:
#   - Set every variable above in the project's Environment Variables panel
#     (Production scope at minimum; copy to Preview if you want previews
#     to fully work).
#   - Image uploads in src/app/api/admin/blog/upload/route.ts write to disk.
#     Vercel's filesystem is ephemeral on serverless — for production
#     blog cover images, swap that route to use @vercel/blob (one-line
#     change: `import { put } from "@vercel/blob"`).
#
# Railway / Render / self-hosted Node:
#   - All env vars set the same way.
#   - Disk-based image uploads work as-is (mount a persistent volume if
#     using Render's free tier).
#
# Stripe live mode:
#   - Activate the account first (business details, payout bank).
#   - Swap STRIPE_SECRET_KEY to sk_live_... and update the webhook
#     endpoint to use a live signing secret (whsec_...).
#
# After changing any var on a hosted environment, redeploy so the new
# value is picked up by the running build.
